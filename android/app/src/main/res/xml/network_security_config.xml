<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Allow cleartext for localhost/development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
    
    <!-- Production domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">anandvrindavan.com</domain>
        <domain includeSubdomains="true">graph.facebook.com</domain>
        <domain includeSubdomains="true">digitaloceanspaces.com</domain>
        <domain includeSubdomains="true">sfo2.digitaloceanspaces.com</domain>
        <domain includeSubdomains="true">avd-bapuji.sfo2.digitaloceanspaces.com</domain>
        <domain includeSubdomains="true">cdninstagram.com</domain>
        <domain includeSubdomains="true">fbcdn.net</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
